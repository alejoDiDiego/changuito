{
  "name": "changuito/bootstrap",
  "description": "Changuito reproducible bootstrap",
  "type": "project",
  "license": "proprietary",
  "require": {"php": "~8.5.0", "ext-pdo_pgsql": "*", "laravel/framework": "~13.39.0", "inertiajs/inertia-laravel": "~3.6.0"},
  "require-dev": {"laravel/pint": "1.32.1", "larastan/larastan": "3.13.2", "pestphp/pest": "4.7.8", "pestphp/pest-plugin-laravel": "4.1.0"},
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "test:unit": "pest --testsuite=Unit --fail-on-empty-test-suite",
    "test:feature": "pest --testsuite=Feature --fail-on-empty-test-suite",
    "test:architecture": "pest --testsuite=Architecture --fail-on-empty-test-suite",
    "lint": "pint --test",
    "analyse": "phpstan analyse --memory-limit=512M --no-progress"
  },
  "config": {"cache-dir": ".cache/composer", "sort-packages": true, "preferred-install": "dist", "allow-plugins": {"pestphp/pest-plugin": true}},
  "minimum-stability": "stable", "prefer-stable": true
}
